<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="lineHeight">18sp</item>
    </style>

    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.App.BodySmall">
        <item name="android:includeFontPadding">false</item>
        <item name="lineHeight">14sp</item>
    </style>

    <style name="TextAppearance.App.Hint" parent="TextAppearance.Material3.BodySmall">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="lineHeight">15sp</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>

        <item name="android:minHeight">40dp</item>
        <item name="backgroundTint">@color/green</item>

        <item name="cornerRadius">30dp</item>

        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/white</item>

        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">0dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.App.ButtonSmall" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="android:minHeight">15dp</item>

        <item name="android:padding">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>

        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/green</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03333333</item>
        <item name="lineHeight">15sp</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/Theme.Overlay.BottomNavigationView</item>
        <item name="itemTextAppearanceActive">@style/Widget.App.ButtonSmall</item>
        <item name="itemTextAppearanceInactive">@style/Widget.App.ButtonSmall</item>
    </style>

    <style name="Theme.Overlay.BottomNavigationView" parent="">
        <item name="colorSurface">@color/dark_gray</item>
        <item name="colorOnSecondaryContainer">@color/green</item>
        <item name="colorOnSurface">@color/green</item>
        <item name="colorSecondaryContainer">@color/light_gray</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
    </style>

</resources>
<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/auth_graph">

    <navigation
        android:id="@+id/auth_graph"
        app:startDestination="@+id/loginFragment">

        <fragment
            android:id="@+id/loginFragment"
            android:name="com.example.coursesapp.presentation.login.LoginFragment"
            android:label="Login" />

    </navigation>

    <navigation
        android:id="@+id/main_graph"
        app:startDestination="@id/homeFragment">

        <fragment
            android:id="@+id/homeFragment"
            android:name="com.example.coursesapp.presentation.home.HomeFragment"
            android:label="Home" />

        <fragment
            android:id="@+id/favoriteFragment"
            android:name="com.example.coursesapp.presentation.favorite.FavoriteFragment"
            android:label="Favorite" />

        <fragment
            android:id="@+id/profileFragment"
            android:name="com.example.coursesapp.presentation.profile.ProfileFragment"
            android:label="Profile" />

    </navigation>

</navigation>